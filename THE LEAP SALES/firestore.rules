rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can only read and write their OWN workspace.
    match /users/{uid}/{coll}/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
                          && coll in ['sheets', 'meta'];
      allow create, update: if request.auth != null && request.auth.uid == uid
                          && coll in ['sheets', 'meta']
                          && request.resource.data.keys().hasOnly(['json', 'by', 'at'])
                          && request.resource.data.json is string
                          && request.resource.data.json.size() < 1000000;
    }

    // everything else is blocked
    match /{document=**} { allow read, write: if false; }
  }
}
